# source this to act as Org1 Admin talking to peer0.org1 (port 7051)
source "$(dirname "${BASH_SOURCE[0]}")/env_common.env"
export CORE_PEER_LOCALMSPID="Org1MSP"
export CORE_PEER_TLS_ROOTCERT_FILE="$ORG1_TLS"
export CORE_PEER_MSPCONFIGPATH="$ORG1_DIR/users/Admin@org1.example.com/msp"
export CORE_PEER_ADDRESS=localhost:7051
echo "Identity: Org1MSP Admin -> peer0.org1.example.com:7051"
