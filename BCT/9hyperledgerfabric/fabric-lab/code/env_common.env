# ---------------------------------------------------------------------------
# env_common.env  -  shared settings + helper functions for the Fabric lab.
# You do NOT run this directly. env_org1.env / env_org2.env load it.
# Usage in EVERY new terminal:   source ~/fabric-lab/code/env_org1.env
# ---------------------------------------------------------------------------
_LABCODE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

export FABRIC_SAMPLES="${FABRIC_SAMPLES:-$HOME/fabric-samples}"   # change if Fabric is installed elsewhere
export TEST_NET="$FABRIC_SAMPLES/test-network"
export PATH="$FABRIC_SAMPLES/bin:$PATH"
export FABRIC_CFG_PATH="$FABRIC_SAMPLES/config"
export CORE_PEER_TLS_ENABLED=true

export CHANNEL=mychannel
export CC=basic

export ORG1_DIR="$TEST_NET/organizations/peerOrganizations/org1.example.com"
export ORG2_DIR="$TEST_NET/organizations/peerOrganizations/org2.example.com"
export ORG1_TLS="$ORG1_DIR/peers/peer0.org1.example.com/tls/ca.crt"
export ORG2_TLS="$ORG2_DIR/peers/peer0.org2.example.com/tls/ca.crt"
export ORDERER_CA="$TEST_NET/organizations/ordererOrganizations/example.com/orderers/orderer.example.com/msp/tlscacerts/tlsca.example.com-cert.pem"

# ---- helper: read-only query (one peer, no ordering, no new block)
#      q '{"function":"ReadAsset","Args":["asset1"]}'
q() { peer chaincode query -C "$CHANNEL" -n "$CC" -c "$1"; }

# ---- helper: write transaction endorsed by BOTH orgs (satisfies the default MAJORITY policy)
#      invoke_both '{"function":"CreateAsset","Args":["asset7","blue","20","Tomoko","500"]}'
invoke_both() {
  peer chaincode invoke -o localhost:7050 --ordererTLSHostnameOverride orderer.example.com \
    --tls --cafile "$ORDERER_CA" -C "$CHANNEL" -n "$CC" \
    --peerAddresses localhost:7051 --tlsRootCertFiles "$ORG1_TLS" \
    --peerAddresses localhost:9051 --tlsRootCertFiles "$ORG2_TLS" \
    -c "$1"
}

# ---- helper: write transaction endorsed by ONLY Org1 (used to demo the policy failure in Task 4b)
invoke_org1() {
  peer chaincode invoke -o localhost:7050 --ordererTLSHostnameOverride orderer.example.com \
    --tls --cafile "$ORDERER_CA" -C "$CHANNEL" -n "$CC" \
    --peerAddresses localhost:7051 --tlsRootCertFiles "$ORG1_TLS" \
    -c "$1"
}

# ---- helper: ledger height (number of blocks)
height() { peer channel getinfo -c "$CHANNEL" 2>&1 | sed -n 's/.*"height":\([0-9]*\).*/\1/p'; }

# ---- helper: fetch + decode + pretty print a block.   show_block newest   |   show_block 5
show_block() {
  local w="${1:-newest}"
  peer channel fetch "$w" "/tmp/blk_$w.pb" -o localhost:7050 --ordererTLSHostnameOverride orderer.example.com \
      --tls --cafile "$ORDERER_CA" -c "$CHANNEL" >/dev/null 2>&1 || { echo "cannot fetch block $w"; return 1; }
  configtxlator proto_decode --input "/tmp/blk_$w.pb" --type common.Block --output "/tmp/blk_$w.json" || return 1
  python3 "$_LABCODE/inspect_block.py" "/tmp/blk_$w.json"
}
