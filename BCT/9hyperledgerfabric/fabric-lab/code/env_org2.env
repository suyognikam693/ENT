# source this to act as Org2 Admin talking to peer0.org2 (port 9051)
source "$(dirname "${BASH_SOURCE[0]}")/env_common.env"
export CORE_PEER_LOCALMSPID="Org2MSP"
export CORE_PEER_TLS_ROOTCERT_FILE="$ORG2_TLS"
export CORE_PEER_MSPCONFIGPATH="$ORG2_DIR/users/Admin@org2.example.com/msp"
export CORE_PEER_ADDRESS=localhost:9051
echo "Identity: Org2MSP Admin -> peer0.org2.example.com:9051"
